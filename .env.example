# Application
NODE_ENV=development
PORT=3001
TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fernleaf?schema=public
# Non-pooled connection used by migrations. For local development this may
# point at the same database as DATABASE_URL.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/fernleaf?schema=public

# Authentication
# Placeholder only - generate a real 32+ character secret per environment and
# never commit it (e.g. `openssl rand -base64 48`).
JWT_SECRET=replace-with-a-long-random-development-secret

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api

# File storage
FILE_STORAGE=db
